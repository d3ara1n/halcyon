{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        // no_std target 无 test crate：避免 cfg(test) 变体和 --all-targets 触发
        // E0463: can't find crate for `test`（各 workspace 均无 #[test]，无损失）。
        // target 不在此设：各 workspace 的 .cargo/config.toml 是唯一事实来源
        "cfg": {
          "setTest": false
        },
        "check": {
          "allTargets": false,
          // os/ 内核构建需要 build-std，但 config 不能全局开启（host 测试会
          // 与 sysroot 的 core/alloc 重复，见 os/.cargo/config.toml 注释），
          // 平时靠 Justfile 注入。extraEnv 只作用于 RA 自己的 cargo check，
          // CLI/测试不受影响；对 user/ 与其 config 内的 build-std 重复无害。
          "extraEnv": {
            "CARGO_UNSTABLE_BUILD_STD": "core,alloc",
            "CARGO_UNSTABLE_BUILD_STD_FEATURES": "compiler-builtins-mem"
          }
        }
      }
    }
  }
}
