{
    "arch": "riscv64",
    "code-model": "medium",
    "cpu": "generic-rv64",
    "data-layout": "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128",
    "eh-frame-header": false,
    "emit-debug-gdb-scripts": true,
    "features": "+m,+a,+c",
    "linker": "riscv64-elf-ld",
    "linker-flavor": "ld",
    "llvm-abiname": "lp64",
    "llvm-target": "riscv64",
    "max-atomic-width": 64,
    "panic-strategy": "abort",
    "relocation-model": "static",
    "target-pointer-width": 64,
    "os": "none"
}
